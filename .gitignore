# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Python virtual environments
.venv/
venv/
env/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Environment variables and credentials
.env
*.env

# Operating system files
.DS_Store
Thumbs.db

# VS Code user settings
.vscode/

